NEXT_PUBLIC_SANITY_STUDIO_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_STUDIO_DATASET=production
NEXT_PUBLIC_SANITY_STUDIO_API_VERSION=2024-07-01
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxx

# Same project ID/dataset as above, duplicated under a different prefix on
# purpose — NOT a mistake. The Next.js app and Sanity Studio are two
# separate build systems (webpack/Turbopack vs. Vite) with two different
# conventions for which env vars get exposed to browser code: Next.js
# looks for NEXT_PUBLIC_, Sanity Studio's Vite tooling looks for
# SANITY_STUDIO_. Using only NEXT_PUBLIC_ works fine for the site but
# fails at runtime in a deployed Studio (`sanity deploy`) with "Missing
# environment variable" — Vite never inlined it into that bundle. Keep
# both sets in sync when the project ID or dataset ever changes.
SANITY_STUDIO_PROJECT_ID=your-project-id
SANITY_STUDIO_DATASET=production

# Server-only — powers the Live Content API's real-time subscription
# (sanity/lib/live.ts). Optional for a public dataset, required for a
# private one. Generate at sanity.io/manage -> this project -> API ->
# Tokens -> Viewer permission.
SANITY_API_READ_TOKEN=

# Server-only — used by scripts/seed.mjs to write content. Never prefix
# this with NEXT_PUBLIC_ (that would expose it to the browser). Generate
# at sanity.io/manage -> this project -> API -> Tokens -> Editor permission.
SANITY_API_WRITE_TOKEN=

# Server-only — required to use /admin/upload-sermon. Requests without a
# matching x-admin-secret header are rejected with 401. Set this to any
# long random string (e.g. `openssl rand -hex 32`) and share it only with
# whoever manages sermon uploads. Leaving this unset disables the upload
# feature entirely (fails closed, not open).
ADMIN_UPLOAD_SECRET=

# Cloudflare R2 — sermon audio storage (server-only, never exposed to the client)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=lfc-jalingo-sermons
R2_PUBLIC_URL=https://sermons.lfcjalingo.org
